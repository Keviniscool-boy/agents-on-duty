OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
# Change to 8081 if port 8080 is already in use.
FRONTEND_PORT=8080
# Embedding：二选一。
# 1) 设置 DASHSCOPE_API_KEY -> 走阿里云 DashScope 原生接口；
# 2) 留空 -> 复用上面的 OPENAI_BASE_URL / OPENAI_API_KEY，走任何
#    OpenAI 兼容的 /embeddings 服务（EMBEDDING_MODEL 换成该服务的模型名）。
# 注意：更换 embedding 模型/提供商后必须删除 vector_store/ 重建索引
#（程序会自动检测并提示）。
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
REDIS_URL=redis://localhost:6379/0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_cs
JWT_SECRET_KEY=replace-with-a-random-string-at-least-32-characters
JWT_EXPIRE_MINUTES=1440
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
